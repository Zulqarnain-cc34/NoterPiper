# Copy to .env and fill in. Only NTFY_TOPIC is required for prayer reminders.

# Required — your private ntfy topic (pick a long random name; subscribe in the app)
NTFY_TOPIC=muezzin-change-me-to-random

# Location (Aladhan). Defaults: Lahore / Pakistan / method 1 (Karachi).
PRAYER_CITY=Lahore
PRAYER_COUNTRY=Pakistan
PRAYER_METHOD=1

# Optional — enable the nightly Habitica nudge (prayer reminders don't need these)
HABITICA_API_TOKEN=
HABITICA_USER_ID=
