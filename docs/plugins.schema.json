{
  "dates": {
    "fields": [
      {
        "key": "enabled",
        "type": "toggle",
        "label": "Date reminders"
      },
      {
        "key": "lead_days",
        "type": "stepper",
        "label": "Remind ahead",
        "hint": "days before the date",
        "min": 0,
        "max": 30,
        "unit": "days"
      },
      {
        "key": "time",
        "type": "time",
        "label": "Time"
      },
      {
        "key": "items",
        "type": "list",
        "label": "Dates",
        "hint": "pick a date \u2014 toggle 'every year' for a birthday",
        "recurring": true,
        "fields": [
          {
            "key": "label",
            "type": "text",
            "label": "What"
          },
          {
            "key": "date",
            "type": "date",
            "label": "Date"
          }
        ]
      }
    ],
    "defaults": {
      "enabled": true,
      "lead_days": 3,
      "time": "09:00",
      "window": 5,
      "items": []
    }
  }
}
